# Generate a new random shared secret; never expose this to browser code.
ANALYSIS_API_KEY=replace-with-a-random-secret-at-least-32-characters
ANALYSIS_PROVIDER=mock
# Hosted photo mode: select ANALYSIS_PROVIDER=openai with a private OPENAI_API_KEY.
# OPENAI_API_KEY=replace-with-a-private-server-only-key
# ANALYSIS_OPENAI_TIMEOUT_SECONDS=30
# Separate nine-slot preview plan: explicit BFF and private-service enablement required.
# ANALYSIS_BEAUTY_PREVIEW_ENABLED=false
# ANALYSIS_BEAUTY_MAKEUP_TIMEOUT_SECONDS=60
# Experimental local mode only: existing private ML workspace, never a cloud-sync folder.
# SENMIVA_ML_WORKSPACE=C:\private\senmiva-ml
# ANALYSIS_PHOTO_MANIFEST=skin-all-001
# ANALYSIS_PHOTO_RUN=skin-all-head-001
# ANALYSIS_INGREDIENT_MANIFEST=ingredients-001
# ANALYSIS_INGREDIENT_RUN=ingredients-linear-001
# ANALYSIS_DEVICE=auto
