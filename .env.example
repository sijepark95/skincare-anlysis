# Demo is explicit. It contains fictional catalog data, never real skin scores.
APP_MODE=demo
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Optional in demo (local mock otherwise); required in Supabase mode.
# ANALYSIS_SERVICE_URL=http://127.0.0.1:8000
# ANALYSIS_API_KEY=replace-with-at-least-32-random-characters
# Explicit choices: mock, experimental (local checkpoints), openai (hosted photo observations).
# No automatic fallback between providers.
ANALYSIS_PROVIDER=mock
# Optional own-photo makeup previews: requires OpenAI image-edit model access.
# Explicitly enable in BOTH BFF and private-service environments; separate guest opt-in required.
ANALYSIS_BEAUTY_MAKEUP_ENABLED=false
# Integrated nine individual makeup/hair/colour previews, separate guest consent.
ANALYSIS_BEAUTY_PREVIEW_ENABLED=false
# Teen photo processing stays off until the operating consent/provider review is complete.
BEAUTY_TEEN_PHOTO_ENABLED=false
# Per image deadline, maximum60s; exactly3 sequential calls, never automatic retries.
ANALYSIS_BEAUTY_MAKEUP_TIMEOUT_SECONDS=60
# OpenAI photo mode requires OPENAI_API_KEY below and separate kiosk photo-transmission consent.
# The model and visible-feature protocol are pinned; it never loads local skin/ingredient models.
# Experimental local inference uses the saved private ML workspace pointer by default.
# SENMIVA_ML_WORKSPACE=C:/private/Senmiva/ml
# ANALYSIS_PHOTO_MANIFEST=skin-all-001
# ANALYSIS_PHOTO_RUN=skin-all-head-001
# ANALYSIS_INGREDIENT_MANIFEST=ingredients-001
# ANALYSIS_INGREDIENT_RUN=ingredients-linear-001
# ANALYSIS_DEVICE=auto
# Set APP_MODE=supabase for authenticated persistent mode. Never expose writer credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: exact public HTTPS origin (no path/port) for seven-day beauty QR guides.
# Keep empty locally. Set after public deployment, e.g. https://beauty.your-domain.com
BEAUTY_PUBLIC_ORIGIN=
# Safe delivery metadata only. SMTP credentials belong in ignored .env.supabase-mail.local.
# Local email tooling sets these after checking the actual Auth transport.
AUTH_EMAIL_DELIVERY=unknown
AUTH_EMAIL_INBOX_URL=
ANALYSIS_DATABASE_URL=
# Optional server-side recommendation explanation for mock/experimental only.
# Disabled automatically in openai photo mode. No image or source dataset is sent by this text path.
# Customer opt-in is required. Missing key keeps the existing local match explanation.
EXPLANATION_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_EXPLANATION_MODEL=gpt-4.1-mini-2025-04-14
# Optional hosted database certificate downloaded from your Supabase project.
# ANALYSIS_DATABASE_CA_FILE=C:/path/to/prod-supabase.cer
# Promotional AI-generated reference footage; customer camera images never go here.
NEXT_PUBLIC_HERO_VIDEO_URL=/media/senmiva-hero.mp4
