{
  "name": "senmiva",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:connected": "node scripts/dev-connected.mjs",
    "supabase:start": "node scripts/supabase-local-start.mjs",
    "supabase:local:prepare": "node scripts/supabase-local-prepare.mjs",
    "supabase:stop": "supabase stop",
    "supabase:email:prepare": "node scripts/supabase-email.mjs --prepare",
    "supabase:email:apply": "node scripts/supabase-email.mjs --apply",
    "supabase:email:check": "node scripts/supabase-email.mjs --check",
    "supabase:check": "node scripts/supabase-setup.mjs --check",
    "supabase:migrate": "node scripts/supabase-setup.mjs --migrate",
    "supabase:init": "node scripts/supabase-setup.mjs --init --mock-policy",
    "test:supabase": "node scripts/supabase-smoke.mjs",
    "test:db": "supabase test db --network-id senmiva-local",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src tests scripts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "node scripts/integration-smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "context": "node scripts/context.mjs",
    "llm:prepare": "node scripts/llm-setup.mjs",
    "format": "prettier --write src tests scripts docs design-system *.ts *.mjs package.json",
    "face:prepare": "node scripts/face-assets.mjs",
    "face:check": "node scripts/face-assets.mjs --check"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "papaparse": "5.7.0",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/papaparse": "5.5.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.10",
    "supabase": "2.120.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
